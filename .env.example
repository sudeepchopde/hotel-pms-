# Example environment configuration for Hotel PMS
# Copy this file to .env or .env.local and update with your values
#
# Dev server uses HTTPS (Vite + @vitejs/plugin-basic-ssl) so camera/ID scan works
# from other devices on the LAN. Use https://192.168.x.x:3001 and trust the cert.

# PostgreSQL — use ONE of these (see backend/database.py for precedence)
# Neon: https://console.neon.tech
# Supabase: Project Settings → Database → copy "URI" (use the password you set)
#   Pooler errors like "Tenant or user not found" = wrong user/password or use Session pooler URI from dashboard
DATABASE_URL=postgresql://username:password@ep-xxxxx-xxxxx.region.aws.neon.tech/dbname?sslmode=require
# POSTGRES_URL=...   # alternative env name (some hosts set this instead)

# Check connection after starting the API: GET http://127.0.0.1:8000/api/db-status
# If status is disconnected, login only works as admin / admin123 until DB is fixed.

# Gemini API Key (for AI features like OCR)
GEMINI_API_KEY=your_api_key_here
VITE_GEMINI_API_KEY=your_api_key_here

# Field-Level Encryption Key (AES-256 via Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Losing this key means all encrypted data (payment secrets, guest IDs) becomes unrecoverable!
ENCRYPTION_KEY=your_generated_fernet_key_here
