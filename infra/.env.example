# Copy to .env and edit
# cp .env.example .env

TZ=Asia/Kolkata

# Pi-hole web UI password (change after first login)
PIHOLE_WEBPASSWORD=change-me-strong-password

# Your Ubuntu server’s LAN IP (helps Pi-hole respond correctly to clients)
PIHOLE_LOCAL_IPV4=192.168.1.100

# Upstream resolvers for Pi-hole (Cloudflare); comma-separated in .env overrides compose default
# PIHOLE_UPSTREAM_DNS=1.1.1.1;1.0.0.1
